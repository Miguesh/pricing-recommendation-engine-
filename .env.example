# Copy this file to .env for local development. Never commit real secrets.

# API runtime
PRICING_ENVIRONMENT=local
PRICING_LOG_LEVEL=INFO
# PRICING_API_KEY=replace-with-at-least-32-random-characters
# PRICING_API_KEY_TENANT_ID=demo-tenant
# PRICING_SERVING_TENANT_ID=demo-tenant
# PRICING_TRUSTED_HOSTS=["localhost","127.0.0.1"]
PRICING_TRUST_PROXY_IDENTITY=false
# PRICING_TRUSTED_TENANT_HEADER=X-Authenticated-Tenant
PRICING_CORS_ORIGINS=["http://localhost:3000"]
PRICING_RECOMMENDATION_MAX_CANDIDATES=500
PRICING_RECOMMENDATION_MAX_CONCURRENCY=4
PRICING_REQUEST_TIMEOUT_SECONDS=5
PRICING_REQUEST_BODY_TIMEOUT_SECONDS=5
# Contract maximum/default. A lower value is an explicit operational override.
PRICING_MAX_REQUEST_BODY_BYTES=1048576

# Serving model. Use a local bundle directory for `make run`, or the registry
# alias after completing the MLflow candidate review and promotion workflow.
# PRICING_MODEL_URI=artifacts/local-model
# PRICING_MODEL_URI=models:/pricing-demand@champion

# The application Settings class reads the PRICING_ prefix. Docker Compose
# overrides this host URL with the internal http://mlflow:5000 service address.
PRICING_MLFLOW_TRACKING_URI=http://localhost:5000
# Required only when the package is installed outside this source checkout.
# PRICING_DEPENDENCY_PROJECT_PATH=/absolute/path/to/pricing-model-contract

# MLflow proxies artifact traffic to MinIO. Host commands and the API never
# receive object-store credentials; only the MLflow service owns them.
